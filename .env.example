# ===========================================
# Irish Tax Agents vCard Web App
# Environment Configuration
# ===========================================

# Admin Password (REQUIRED for production)
# Change this to a strong, unique password
# In Docker: set this as an environment variable on the container
# (e.g. docker run -e VITE_ADMIN_PASSWORD=...) - it is read at container
# startup, so changing it only requires a restart, not a rebuild.
VITE_ADMIN_PASSWORD=your_secure_password_here

# ===========================================
# Heroku Configuration
# ===========================================
# Set these in Heroku Dashboard > Settings > Config Vars
# NODE_ENV=production
# ===========================================
